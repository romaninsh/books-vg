# --- managed by Vantage: generated files (do not edit this block)
#
# Vantage rewrites these on every open, from the running build.
# Commit them and they go stale, and every version bump becomes a
# diff nobody wrote.
*/*-schema-*.json
*/README.md
/AGENTS.md

# Machine-local, not content: the install record an app keeps so it
# can update itself, the row caches, the credentials files (`.env`
# and each profile's, like `.env.prod`), and the local data files the
# connect wizard placed (CSV, SQLite), and third-party reference
# material copied in for the agent (`refs/`).
manifest.yaml
.cache/
.env
.env.*
data/
/refs/
.DS_Store
# --- end managed by Vantage

!.env.example

# Cloud credentials for tests/load_cloud.sh and the deploy (never committed).
/private/
# The full books stay on the owner's machine (the repository carries tests/sample.surql, cut
# from them), and so do the importer and the notes kept beside them (.git/info/exclude).
/tests/seed.surql
# browser-automation snapshots and screenshots (they can show real pages)
/.playwright-mcp/

# Skill copies Vantage installs and refreshes in every project it opens, and the local MCP address.
.agents/
.claude/
.mcp.json

