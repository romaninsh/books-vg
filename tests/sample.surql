-- The sample books: 2018-10-01 to 2019-03-31 of the anonymised books (scripts/make_sample.py).
-- Loaded by tests/load.sh when the full tests/seed.surql isn't there (it is never committed).
REMOVE EVENT IF EXISTS nominal_delete ON nominal;
REMOVE EVENT IF EXISTS invoice_line_touch ON invoice_line;
BEGIN TRANSACTION;
REMOVE EVENT IF EXISTS allocation_touch ON allocation;
DELETE allocation; DELETE payment;
DELETE invoice_line; DELETE invoice; DELETE misc; DELETE doc; DELETE contact;
DELETE bank_account; DELETE nominal;
CREATE nominal:fixed_assets SET code = "11000", name = "Fixed assets", type = "Fixed asset", bp = "B", rank = 1;
CREATE nominal:accumulated_depreciation SET code = "12000", name = "Accumulated depreciation", type = "Fixed asset", bp = "B", rank = 2;
